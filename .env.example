# myKuniran Environment Configuration Template
# Masukkan nilai kredensial riil ke Secrets Panel di AI Studio / file .env lokal (dilarang commit secret riil)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
APP_LINK_HOST=mykuniran.app
